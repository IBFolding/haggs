{
  "name": "haggs",
  "private": true,
  "description": "An open-source film studio on Comfy: pictures, video, series and an editor, with every price shown before you press the button.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IBFolding/haggs.git"
  },
  "homepage": "https://haggsfield.studio",
  "bugs": {
    "url": "https://github.com/IBFolding/haggs/issues"
  },
  "keywords": [
    "comfyui",
    "comfy",
    "ai-video",
    "film",
    "storyboard",
    "open-source",
    "nextjs"
  ],
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3111",
    "build": "next build",
    "start": "next start --port 3111",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "prices": "tsx src/catalog/pricing.test.ts",
    "test": "node --import tsx --test \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fal-ai/client": "^1.6.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jsonata": "^2.2.2",
    "next": "^16.3.5",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
